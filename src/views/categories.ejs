<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>
    <p>Browse service work by what your LGA, market, or community development association needs.</p>
    <ul class="category-list">
        <% categories.forEach((category) => { %>
            <li>
                <div class="card-body">
                    <h2><%= category.name %></h2>
                </div>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>
