<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>
    <p>These service projects support monthly environmental sanitation, market refuse collection, and primary health centre outreach.</p>
    <ul class="project-list">
        <% projects.forEach((project) => { %>
            <li>
                <div class="card-body">
                    <h2><%= project.formattedDate %>: <%= project.title %> (<%= project.organization_name %>)</h2>
                    <p><%= project.location %></p>
                    <p><%= project.description %></p>
                </div>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>
