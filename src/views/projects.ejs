<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>
    <p>These service projects support monthly environmental sanitation, market refuse collection, and primary health centre outreach.</p>
    <ul class="project-list">
        <% serviceProjects.forEach((project) => { %>
            <li>
                <img src="<%= project.image %>" alt="<%= project.alt %>">
                <div class="card-body">
                    <p class="badge"><%= project.category %></p>
                    <h2><%= project.name %></h2>
                    <p><%= project.summary %></p>
                    <h3>Requirements</h3>
                    <ul class="requirement-list">
                        <% project.requirements.forEach((requirement) => { %>
                            <li><%= requirement %></li>
                        <% }); %>
                    </ul>
                </div>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>
