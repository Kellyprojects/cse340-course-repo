<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>
    <p>These ministries and agencies handle environmental policy, refuse collection, dumpsite inspection, and primary health care.</p>
    <ul class="org-list">
        <% partnerOrganizations.forEach((organization) => { %>
            <li>
                <img src="<%= organization.image %>" alt="<%= organization.alt %>">
                <div>
                    <p><strong><%= organization.name %></strong>: <%= organization.email %></p>
                    <p><%= organization.summary %></p>
                </div>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>
