<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>
    <p>These ministries and agencies handle environmental policy, refuse collection, dumpsite inspection, and primary health care.</p>
    <ul class="org-list">
        <% organizations.forEach((organization) => { %>
            <li>
                <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                <div class="card-body">
                    <h2><%= organization.name %></h2>
                    <p class="card-email"><%= organization.contact_email %></p>
                    <p><%= organization.description %></p>
                </div>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>
