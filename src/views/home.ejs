<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>

    <section class="hero">
        <h2>Keep every LGA clean, neat, and healthy</h2>
        <p>CleanState helps the Federal Ministry of Environment, state ministries, waste authorities, and environmental health officers track refuse, drainage, and community health across Nigeria.</p>
        <p class="hero__actions">
            <a class="button" href="/projects">View service projects</a>
            <a class="button button--secondary" href="/organizations">Meet partner ministries</a>
        </p>
    </section>

    <img class="hero-photo" src="/images/category-environmental.jpg" alt="Community workers keeping a Nigerian street clean">

    <section class="featured">
        <h2>This week across the states</h2>
        <ul class="kpi-grid">
            <% stateSnapshot.forEach((item) => { %>
                <li>
                    <p class="kpi-grid__label"><%= item.label %></p>
                    <p class="kpi-grid__value"><%= item.value %></p>
                </li>
            <% }); %>
        </ul>
    </section>

    <section class="featured">
        <h2>State and LGA neatness scorecard</h2>
        <ul class="score-list">
            <% districtScores.forEach((district) => { %>
                <li>
                    <h3><%= district.name %></h3>
                    <p class="badge">Score <%= district.score %></p>
                    <p><%= district.focus %></p>
                </li>
            <% }); %>
        </ul>
    </section>

    <section class="featured">
        <h2>Nigeria service map</h2>
        <p>Find a state or LGA on the map, then open Projects for sanitation, market cleanup, or primary health centre support.</p>
        <iframe
            class="live-map"
            title="Map of Nigeria"
            src="https://www.openstreetmap.org/export/embed.html?bbox=2.67,4.24,14.68,13.89&amp;layer=mapnik"
            loading="lazy">
        </iframe>
    </section>
</main>

<%- include('partials/footer') %>
